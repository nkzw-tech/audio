{
  "name": "@nkzw/audio",
  "version": "1.0.0",
  "description": "Cross-platform audio playback for the web.",
  "keywords": [
    "audio",
    "audio sprite",
    "audiosprite",
    "browser",
    "html5",
    "html5 audio",
    "sound",
    "web audio",
    "webaudio"
  ],
  "homepage": "https://github.com/nkzw-tech/audio",
  "license": "MIT",
  "author": {
    "name": "Christoph Nakazawa",
    "email": "christoph.pojer@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/audio"
  },
  "files": [
    "lib",
    "LICENSE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./music": {
      "import": {
        "types": "./lib/music.d.ts",
        "default": "./lib/music.js"
      },
      "require": {
        "types": "./lib/music.d.cts",
        "default": "./lib/music.cjs"
      }
    },
    "./music/worker": {
      "types": "./lib/music-worker.d.ts",
      "import": "./lib/music-worker.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack && vp dev --open /examples/",
    "prepack": "vp pack 1>&2",
    "prepare": "vp config",
    "test": "vp pack && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^2.0.1",
    "@types/node": "^24.19.2",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3",
    "vite-plus": "1.5.0"
  },
  "packageManager": "pnpm@12.18.0"
}
